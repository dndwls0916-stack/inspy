# 이 파일을 .env 로 복사한 뒤 사용할 AI의 키만 채우세요. (키가 있는 AI만 회의에 참여합니다)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 모델 고정 (보통은 비워 두세요: 화면의 "자동"이 지금 쓸 수 있는 모델을 알아서 고릅니다)
# 여기에 적으면 그 모델로 고정되어 "자동"이 꺼집니다. 모델 이름은 서비스가 자주 바꿉니다.
# OPENAI_MODEL=
# GEMINI_MODEL=
# ANTHROPIC_MODEL=

# 실행 방식 기본값: api / cli / mixed (화면에서도 바꿀 수 있음)
# mixed = API 키가 있는 AI 는 API, 없는 AI 는 CLI. 비워 두면 자동으로 정합니다.
# MODE=mixed

# CLI 경로가 PATH 에 없을 때만 지정
# CLAUDE_BIN=
# CODEX_BIN=
# GEMINI_BIN=

PORT=3000

# --- 안전 / 기록 (모두 선택) ---
# 회의 한 번의 AI 호출 상한 기본값 (화면에서 바꿀 수 있음, 10~500)
# MAX_CALLS=120
# 회의록 자동 저장을 끄려면 1 (기본은 실행파일 옆 '회의록' 폴더에 저장)
# NO_MINUTES=1
# 회의록 저장 폴더를 바꾸려면
# MINUTES_DIR=C:\Users\내이름\Documents\회의록

# --- 더 많은 AI (모두 선택, API 키 방식만 지원) ---
# 키를 넣으면 참가자 추가 목록에서 쓸 수 있게 됩니다. 모델 이름은 화면의 드롭다운에서 고릅니다(서비스가 알려 주는 목록).
# XAI_API_KEY=         # Grok (xAI)
# DEEPSEEK_API_KEY=    # DeepSeek
# MISTRAL_API_KEY=     # Mistral
# PERPLEXITY_API_KEY=  # Perplexity (웹 검색 내장 — 최신 정보가 필요할 때)
# GROQ_API_KEY=        # Groq (Llama·Qwen 등 오픈 모델을 빠르게)
# OPENROUTER_API_KEY=  # OpenRouter (키 하나로 수백 개 모델)
# 내 PC에서 돌리는 무료 모델(Ollama): 아래 중 하나를 적으면 사용 가능. 모델은 `ollama pull llama3.1` 로 미리 받아 두세요.
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# 그 밖에 OpenAI 호환 주소를 쓰는 서버(사내 서버, LM Studio, vLLM 등)
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_MODEL=모델이름
# CUSTOM_API_KEY=      # 필요한 경우만
# CUSTOM_LABEL=사내 모델
