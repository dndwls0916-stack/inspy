# 이 파일을 .env 로 복사한 뒤 사용할 AI의 키만 채우세요. (키가 있는 AI만 회의에 참여합니다)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 기본 모델 (화면에서도 바꿀 수 있습니다)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5

# 실행 방식 기본값: api / cli / mixed (화면에서도 바꿀 수 있음)
# mixed = API 키가 있는 AI 는 API, 없는 AI 는 CLI. 비워 두면 자동으로 정합니다.
# MODE=mixed

# CLI 경로가 PATH 에 없을 때만 지정
# CLAUDE_BIN=
# CODEX_BIN=
# GEMINI_BIN=

PORT=3000
